{
  "name": "kidea-r05-web-sample",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.3",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  },
  "scripts": {
    "sync": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "build": "vite build",
    "test:browser": "playwright test --project=chromium --workers=1 --retries=0 --forbid-only",
    "test:server": "node --test tests/server/*.test.mjs"
  }
}
