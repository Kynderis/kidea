import test from 'node:test';import assert from 'node:assert/strict';
import {AdminUpdates,LiveIdentity,decodeSession,collectionEpoch,watchCollection} from '../../src/lib/collections.ts';
const who=(extra={})=>({actor:'A',epoch:'E',csrf:'FAKE-CSRF-A',admin:true,participant:true,...extra});
const snapshot=(extra={})=>({id:'W',epoch:'E',version:'1',state:'OPEN',title:'Workshop',description:'Plain text',capacity:2,active:0,remaining:2,observedAt:1,schedule:{start:'2026-10-01T09:00:00+07:00',end:'2026-10-01T10:00:00+07:00'},...extra});
const response=(body,status=200)=>new Response(JSON.stringify(body),{status});
const flush=async()=>{for(let n=0;n<80;n++)await Promise.resolve();};
test('identity decoding checks the actual audience role and nonempty metadata',()=>{assert.ok(decodeSession(who(),'admin'));assert.ok(decodeSession(who(),'private'));for(const raw of [who({actor:''}),who({epoch:''}),who({csrf:''}),who({admin:false})])assert.equal(decodeSession(raw,'admin'),null);assert.equal(decodeSession(who({participant:false}),'private'),null);});
test('temporary 429/503 hides private data without changing actor or generation',async()=>{let value=response(who());const notices=[];const identity=new LiveIdentity('private','E',async()=>value,(...v)=>notices.push(v));assert.equal(await identity.validate(),true);const gen=identity.generation;for(const status of [429,503]){value=response({},status);assert.equal(await identity.validate(),false);assert.equal(identity.who.actor,'A');assert.equal(identity.confirmed,false);assert.equal(identity.active,true);assert.equal(identity.generation,gen);value=response(who());assert.equal(await identity.validate(),true);}assert.ok(notices.some(v=>v[0]===false&&v[1]===false));identity.end();});
test('network failure is UNKNOWN and can recover under the same identity',async()=>{let fail=false;const identity=new LiveIdentity('admin','E',async()=>{if(fail)throw Error('network');return response(who());},()=>{});assert.equal(await identity.validate(),true);fail=true;assert.equal(await identity.validate(),false);assert.equal(identity.active,true);fail=false;assert.equal(await identity.validate(),true);identity.end();});
test('confirmed revocation, role/actor/epoch/schema changes permanently erase identity',async()=>{for(const changed of [response({},401),response({},403),response(who({admin:false})),response(who({actor:'B'})),response(who({epoch:'NEW'})),response(who({csrf:''})),new Response('{')]){let value=response(who());const identity=new LiveIdentity('admin','E',async()=>value,()=>{});assert.equal(await identity.validate(),true);value=changed;assert.equal(await identity.validate(),false);assert.equal(identity.active,false);assert.equal(identity.who,null);assert.equal(identity.confirmed,false);assert.equal(await identity.validate(),false);}});
test('anonymous public 401 is allowed but a known actor cannot silently downgrade',async()=>{let value=response({},401);const guest=new LiveIdentity('public','E',async()=>value,()=>{});assert.equal(await guest.validate(),true);assert.equal(guest.who.actor,'');guest.end();value=response(who());const signed=new LiveIdentity('public','E',async()=>value,()=>{});assert.equal(await signed.validate(),true);value=response({},401);assert.equal(await signed.validate(),false);assert.equal(signed.who,null);});
test('a late session response cannot reveal data after disposal or identity loss',async()=>{let finish;const notices=[];const identity=new LiveIdentity('private','E',()=>new Promise(r=>finish=r),(...v)=>notices.push(v));const pending=identity.validate();identity.end();finish(response(who()));assert.equal(await pending,false);assert.deepEqual(notices,[[false,true]]);assert.equal(identity.who,null);});
test('collection epoch only comes from a whole valid nonduplicate same-epoch batch',()=>{assert.equal(collectionEpoch([],'public'),null);assert.equal(collectionEpoch([snapshot()],'public'),'E');for(const values of [[snapshot({state:'DRAFT'})],[snapshot(),snapshot()],[snapshot(),snapshot({id:'B',epoch:'NEW'})],[snapshot({remaining:3})]])assert.equal(collectionEpoch(values,'public'),null);assert.equal(collectionEpoch([snapshot({state:'DRAFT'})],'admin'),'E');});
test('admin collection includes drafts, keeps per-workshop exact uint64 high-water and never deletes by omission',()=>{const model=new AdminUpdates('E',[]);assert.equal(model.merge([snapshot({state:'DRAFT',version:'9007199254740993'})],'SOCKET'),true);model.merge([snapshot({version:'9007199254740992',title:'Old'})],'HTTP');model.merge([snapshot({id:'OTHER',version:'1'})],'SOCKET');model.merge([],'HTTP');assert.equal(model.snapshots.get('W').state,'DRAFT');assert.equal(model.snapshots.size,2);});
test('admin equal-version conflict remains UNKNOWN until authoritative HTTP reconciliation',()=>{const model=new AdminUpdates('E',[snapshot()]);assert.equal(model.merge([snapshot({title:'Conflict'})],'SOCKET'),false);assert.equal(model.snapshots.get('W').title,'Workshop');assert.equal(model.merge([snapshot()],'SOCKET'),false);assert.equal(model.merge([snapshot()],'HTTP'),true);});
test('malformed or duplicate admin batches never partially apply or leak extra identity fields',()=>{const model=new AdminUpdates('E',[]);for(const values of [[snapshot(),snapshot({id:'B',epoch:'WRONG'})],[snapshot(),snapshot({title:'Conflict'})]]){assert.equal(model.merge(values,'SOCKET'),false);assert.equal(model.snapshots.size,0);}assert.equal(model.merge([snapshot({actor:'PRIVATE',csrf:'PRIVATE'})],'SOCKET'),true);assert.equal('actor'in model.snapshots.get('W'),false);});
test('collection subscribes to star before GET and late data after stop is ignored',async()=>{const listeners={},sent=[],reads=[],values=[];let finish;const wire={state:()=>1,send:s=>sent.push(JSON.parse(s)),close:()=>{},listen:(k,fn)=>listeners[k]=fn};const stop=watchCollection({audience:'admin',initial:[],session:async()=>response(who()),read:()=>{reads.push('GET');return new Promise(r=>finish=r);},snapshots:v=>values.push(v),status:()=>{},visibility:()=>{},factory:()=>wire});await flush();listeners.open();await flush();assert.equal(sent[0].workshopId,'*');assert.deepEqual(reads,[]);listeners.message(JSON.stringify({message:{type:'SUBSCRIBED',audience:'admin',epoch:'E'},receipt:'x'.repeat(32)}));await flush();assert.deepEqual(reads,['GET']);stop();finish([snapshot({state:'DRAFT'})]);await flush();assert.deepEqual(values,[]);assert.equal(sent.length,1);});
test('empty public bootstrap uses actual HTTP epoch without opening a fabricated subscription',async()=>{let finish;const sent=[],listeners={},values=[];let opened=0;const stop=watchCollection({audience:'public',initial:[],session:async()=>response({},401),read:()=>new Promise(r=>finish=r),snapshots:v=>values.push(v),status:()=>{},visibility:()=>{},factory:()=>{opened++;return {state:()=>1,send:s=>sent.push(JSON.parse(s)),close:()=>{},listen:(k,fn)=>listeners[k]=fn};}});assert.equal(opened,0);finish([snapshot({epoch:'ACTUAL'})]);await flush();assert.equal(opened,1);listeners.open();await flush();assert.equal(sent[0].epoch,'ACTUAL');assert.equal(sent[0].workshopId,'*');stop();assert.deepEqual(values,[]);});
