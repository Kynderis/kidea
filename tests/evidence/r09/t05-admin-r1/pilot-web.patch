--- /dev/null
+++ b/web/tests/unit/admin.test.mjs
@@ -0,0 +1,24 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import {decodeAdmin,formOf,changedFields,fieldErrors,confirmation,sameObservation,compareAdminObservation,rebaseDraft,decodeAdminIntent,prepareAdminSend,decodeAdminResult} from '../../src/lib/admin.ts';
+const snap=()=>({id:'W',epoch:'E',version:'1',state:'DRAFT',title:'Workshop',description:'Văn bản',capacity:10,active:2,remaining:8,observedAt:1,schedule:{start:'2026-10-01T09:00:00+07:00',end:'2026-10-01T10:00:00+07:00'}});
+const intent=(action='CREATE')=>({actor:'A',epoch:'E',sent:false,state:'UNKNOWN',command:{epoch:'E',intentId:'I',action,...(action==='CREATE'?{fields:{title:'Workshop'}}:action==='EDIT'?{workshopId:'W',fields:{title:'Tên mới'}}:{workshopId:'W',targetState:'OPEN'})}});
+test('admin snapshot accepts DRAFT but strips extraneous private identity',()=>{assert.deepEqual(decodeAdmin({...snap(),participant:'secret'}),snap());});
+for(const [key,val]of Object.entries({state:'BROKEN',remaining:99,version:'18446744073709551616',epoch:''}))test('admin refuses invalid '+key,()=>assert.equal(decodeAdmin({...snap(),[key]:val}),null));
+test('dirty patch excludes untouched fields',()=>{const b=snap(),d=formOf(b);d.title='Changed';assert.deepEqual(changedFields(b,d),{title:'Changed'});});
+test('schedule edits always send both endpoints',()=>{const b=snap(),d=formOf(b);d.end='2026-10-02T10:00:00+07:00';assert.deepEqual(changedFields(b,d),{schedule:{start:b.schedule.start,end:d.end}});});
+test('explicit review preserves only edited fields over newest data',()=>{const b=snap(),d=formOf(b);d.title='My change';const n={...b,version:'2',description:'Other editor',capacity:11,remaining:9};const merged=rebaseDraft(b,n,d);assert.equal(merged.title,'My change');assert.equal(merged.description,'Other editor');assert.equal(merged.capacity,'11');assert.deepEqual(changedFields(n,merged),{title:'My change'});});
+test('same field remains an explicit user decision, not a silent overwrite',()=>{const b=snap(),d=formOf(b);d.title='Mine';const n={...b,version:'2',title:'Theirs'};assert.equal(rebaseDraft(b,n,d).title,'Mine');assert.equal(formOf(n).title,'Theirs');});
+test('observation time alone does not trigger a stale edit, state/count/version do',()=>{const b=snap();assert.equal(sameObservation(b,{...b,observedAt:2}),true);for(const extra of [{state:'OPEN'},{version:'2'},{active:3,remaining:7},{title:'New'}])assert.equal(sameObservation(b,{...b,...extra}),false);});
+test('sensitive changes share one confirmation with both consequences',()=>{const b=snap();assert.equal(confirmation(b,{capacity:9,schedule:{start:'X',end:'Y'}}).length,2);assert.equal(confirmation(b,{capacity:11,title:'New'}).length,0);assert.equal(confirmation({...b,active:0},{schedule:{start:'X',end:'Y'}}).length,0);});
+for(const [key,value]of Object.entries({title:'\n',description:'',capacity:'1.5',start:'2026-10-01T09:00:00',end:'2026-09-01T09:00:00Z'}))test('field error for '+key,()=>{const d=formOf(snap());d[key]=value;assert.ok(fieldErrors(d)[key]);});
+test('Unicode point count and explicit offsets retain valid inputs',()=>{const d=formOf(snap());d.title='😀'.repeat(120);assert.deepEqual(fieldErrors(d),{});d.title+='😀';assert.ok(fieldErrors(d).title);});
+test('persist before POST, double submit and reload only GET',()=>{const p=intent();let saved;assert.equal(prepareAdminSend(p,x=>{saved=x;assert.equal(p.sent,false);assert.equal(JSON.parse(x).sent,true);}), 'POST');assert.equal(prepareAdminSend(p,()=>assert.fail()),'GET');const restored=decodeAdminIntent(saved,'A','E');assert.equal(prepareAdminSend(restored,()=>assert.fail()),'GET');assert.deepEqual(restored.command,p.command);});
+test('storage failure prevents sending and preserves unsent state',()=>{const p=intent();assert.throws(()=>prepareAdminSend(p,()=>{throw Error('FULL');}));assert.equal(p.sent,false);});
+for(const [actor,epoch]of [['B','E'],['A','NEW']])test('intent cannot cross '+actor+'/'+epoch,()=>assert.equal(decodeAdminIntent(JSON.stringify(intent()),actor,epoch),null));
+test('corrupt and mismatched payload cannot unlock replacement',()=>{assert.equal(decodeAdminIntent('{','A','E'),null);const p=intent();p.command.epoch='WRONG';assert.equal(decodeAdminIntent(JSON.stringify(p),'A','E'),null);});
+for(const action of ['CREATE','EDIT','STATE'])test('decode correct '+action+' final only',()=>{const p=intent(action),code=action==='CREATE'?'CREATED':'UPDATED';assert.ok(decodeAdminResult({state:'FINAL',code,effect:'APPLIED',workshopId:'W'},p));for(const extra of [{state:'UNKNOWN'},{effect:'REJECTED'},{code:'REGISTERED'}])assert.equal(decodeAdminResult({state:'FINAL',code,effect:'APPLIED',workshopId:'W',...extra},p),null);});
+test('create gets exact result ID, never title or current state',()=>{const p=intent();assert.equal(decodeAdminResult({state:'FINAL',code:'CREATED',effect:'APPLIED',title:'Same title'},p),null);assert.equal(decodeAdminResult({state:'FINAL',code:'UPDATED',effect:'APPLIED',workshopId:'W'},p),null);});
+test('edit/state results bind exact target and action',()=>{for(const action of ['EDIT','STATE'])assert.equal(decodeAdminResult({state:'FINAL',code:'UPDATED',effect:'APPLIED',workshopId:'OTHER'},intent(action)),null);assert.equal(decodeAdminResult({state:'FINAL',code:'BELOW_ACTIVE',effect:'REJECTED',workshopId:'W'},intent('STATE')),null);});
+
+test('admin observation conflict includes same-version content and wrong identity',()=>{const b=snap();for(const patch of [{title:'Contradiction'},{active:3,remaining:7},{id:'OTHER'},{epoch:'OTHER'}])assert.equal(compareAdminObservation(b,{...b,...patch}),'CONFLICT');});
+test('admin observation order preserves exact uint64 and ignores timestamp-only changes',()=>{const b={...snap(),version:'9007199254740993'};assert.equal(compareAdminObservation(b,{...b,observedAt:2}),'SAME');assert.equal(compareAdminObservation(b,{...b,version:'9007199254740992'}),'OLDER');assert.equal(compareAdminObservation(b,{...b,version:'9007199254740994'}),'NEWER');});
