using JsonValue = workshop::Json;
namespace {
std::string selected;
unsigned assertions{};
void check(bool value, const std::string &variant) {
  JsonValue j;
  j["caseId"] = selected;
  j["sequence"] = assertions;
  j["variant"] = variant;
  j["status"] = value ? "PASS" : "FAIL";
  std::cout << workshop::dump(j) << '\n' << std::flush;
  if (!value)
    throw std::runtime_error(variant);
  ++assertions;
}
std::string load(const std::string &path) {
  std::ifstream f(path);
  if (!f)
    throw std::runtime_error("fixture input missing");
  return {std::istreambuf_iterator<char>(f), {}};
}
JsonValue valid() {
  return workshop::decode(
      R"({"title":"Lớp học thủ công","description":"Buổi thực hành","capacity":10,"schedule":{"start":"2026-10-01T09:00:00+07:00","end":"2026-10-01T10:00:00+07:00"}})");
}
struct Fixture {
  std::string file;
  std::unique_ptr<workshop::Store> store;
  unsigned sequence{};
  Fixture() {
    static std::atomic<unsigned> counter{};
    const char *output = std::getenv("WORKSHOP_CASE_ROOT");
    if (!output)
      throw std::runtime_error("explicit case evidence root required");
    const auto dir = std::filesystem::path(output) /
                     (selected + "-" + std::to_string(getpid()) + "-" +
                      std::to_string(counter++));
    if (!std::filesystem::create_directories(dir))
      throw std::runtime_error("CREATE_ONLY");
    file = (dir / "db.sqlite").string();
    JsonValue seed;
    seed["epoch"] = "epoch-test";
    seed["origin"] = "https://workshop.test";
    seed["sessions"] = JsonValue(::Json::arrayValue);
    for (const std::string who : {"U", "V", "A", "M"}) {
      JsonValue s;
      s["actor"] = who;
      s["token"] = "FAKE-" + who;
      s["csrf"] = "FAKE-CSRF-" + who;
      s["participant"] = who != "A";
      s["admin"] = who == "A" || who == "M";
      s["expires"] = ::Json::Int64(4102444800);
      seed["sessions"].append(s);
    }
    workshop::Store::initialize(file, load(WORKSHOP_SCHEMA), seed);
    store = std::make_unique<workshop::Store>(file);
  }
  workshop::Response call(const std::string &who, const std::string &route,
                          const JsonValue &j = JsonValue{},
                          const std::string &method = "POST") {
    const auto beforeActive = active(), beforeEvents = events();
    auto result = store->handle(method, route, who == "G" ? "" : "FAKE-" + who,
                                "FAKE-CSRF-" + who, "https://workshop.test", j,
                                1800000000);
    JsonValue observation;
    observation["caseId"] = selected;
    observation["method"] = method;
    observation["route"] = route;
    observation["fakeActor"] = who;
    observation["request"] = j;
    observation["status"] = result.status;
    observation["result"] = result.body;
    observation["beforeActive"] = static_cast<::Json::Int64>(beforeActive);
    observation["afterActive"] = static_cast<::Json::Int64>(active());
    observation["beforeOutbox"] = static_cast<::Json::Int64>(beforeEvents);
    observation["afterOutbox"] = static_cast<::Json::Int64>(events());
    std::ofstream log(std::filesystem::path(file).parent_path() /
                          "observations.jsonl",
                      std::ios::app);
    log << workshop::dump(observation) << '\n';
    if (!log)
      throw std::runtime_error("evidence write");
    return result;
  }
  JsonValue base() {
    JsonValue j;
    j["epoch"] = "epoch-test";
    return j;
  }
  workshop::Response admin(const std::string &action, const std::string &wid,
                           const JsonValue &value,
                           const std::string &request = "") {
    auto j = base();
    j["intentId"] =
        request.empty() ? "admin-" + std::to_string(++sequence) : request;
    j["action"] = action;
    if (action != "CREATE")
      j["workshopId"] = wid;
    if (action == "STATE")
      j["targetState"] = value;
    else
      j["fields"] = value;
    return call("A", "/admin/intents", j);
  }
  std::string create(int capacity = 10, const std::string &state = "OPEN") {
    auto f = valid();
    f["capacity"] = capacity;
    auto r = admin("CREATE", "", f);
    if (r.body["code"] != "CREATED")
      throw std::runtime_error("create failed");
    const auto wid = r.body["workshopId"].asString();
    if (state != "DRAFT") {
      admin("STATE", wid, "OPEN");
      if (state == "PAUSED")
        admin("STATE", wid, "PAUSED");
    }
    return wid;
  }
  workshop::Response reg(const std::string &who, const std::string &wid,
                         const std::string &request = "",
                         const std::string &rid = "") {
    auto j = base();
    j["requestId"] =
        request.empty() ? "request-" + std::to_string(++sequence) : request;
    j["workshopId"] = wid;
    return call(who,
                rid.empty() ? "/registrations"
                            : "/registrations/" + rid + "/cancel",
                j);
  }
  std::int64_t count(const std::string &sql) {
    sqlite3 *db{};
    if (sqlite3_open_v2(file.c_str(), &db, SQLITE_OPEN_READONLY, nullptr) !=
        SQLITE_OK)
      throw std::runtime_error("oracle open");
    sqlite3_stmt *q{};
    if (sqlite3_prepare_v2(db, sql.c_str(), -1, &q, nullptr) != SQLITE_OK ||
        sqlite3_step(q) != SQLITE_ROW)
      throw std::runtime_error("oracle query");
    auto result = sqlite3_column_int64(q, 0);
    sqlite3_finalize(q);
    sqlite3_close(db);
    return result;
  }
  void sql(const std::string &sql) {
    sqlite3 *db{};
    if (sqlite3_open(file.c_str(), &db) != SQLITE_OK)
      throw std::runtime_error("fixture open");
    const int r = sqlite3_exec(db, sql.c_str(), nullptr, nullptr, nullptr);
    sqlite3_close(db);
    if (r != SQLITE_OK)
      throw std::runtime_error("fixture setup");
  }
  std::int64_t active() {
    return count("SELECT count(*) FROM registrations WHERE state='ACTIVE'");
  }
  std::int64_t events() { return count("SELECT count(*) FROM outbox"); }
  void code(const workshop::Response &r, const std::string &expected,
            const std::string &variant) {
    check(r.status == 200 && r.body["state"] == "FINAL" &&
              r.body["code"] == expected,
          variant);
  }
};
void permission() {
  if (selected == "P04")
    for (const std::string state : {"OPEN", "PAUSED"}) {
      Fixture f;
      auto w = f.create();
      auto rid = f.reg("U", w).body["registrationId"].asString();
      if (state == "PAUSED")
        f.admin("STATE", w, "PAUSED");
      check(f.reg("V", w, "one", rid).body ==
                f.reg("V", w, "two", "missing").body,
            "cancel-hidden-equals-missing-" + state);
    }
  if (selected == "P02")
    for (const std::string who : {"G", "U", "V", "A", "M"})
      for (const std::string action : {"CREATE", "EDIT"}) {
        Fixture f;
        auto w = f.create();
        auto j = f.base();
        j["intentId"] = "role";
        j["action"] = action;
        j["fields"] = valid();
        if (action == "EDIT")
          j["workshopId"] = w;
        const auto result = f.call(who, "/admin/intents", j);
        check(result.status == ((who == "A" || who == "M") ? 200
                                : who == "G"               ? 401
                                                           : 404),
              std::string("admin-role-").append(who).append(action));
      }
  if (selected == "P01" || selected == "P04") {
    for (const std::string state : {"DRAFT", "OPEN", "PAUSED"})
      for (const std::string who : {"G", "U", "A"}) {
        Fixture f;
        auto w = f.create(10, state);
        auto r = f.call(who, "/workshops/" + w, {}, "GET");
        check(r.status == (state == "DRAFT" ? 404 : 200),
              std::string(state).append("-").append(who));
        if (state == "DRAFT")
          check(r.body == f.call(who, "/workshops/missing", {}, "GET").body,
                "hidden-equals-missing-" + who);
        check(f.call(who, "/admin/workshops/" + w, {}, "GET").status ==
                  (who == "A"   ? 200
                   : who == "G" ? 401
                                : 404),
              std::string("admin-scope-").append(state).append(who));
      }
  } else if (selected == "P02" || selected == "P03") {
    for (const std::string who : {"G", "U", "V", "A", "M"}) {
      Fixture f;
      auto w = f.create();
      auto r = f.reg(who, w);
      check(r.status == (who == "G"   ? 401
                         : who == "A" ? 404
                                      : 200),
            "register-" + who);
      auto j = f.base();
      j["intentId"] = "x";
      j["action"] = "STATE";
      j["workshopId"] = w;
      j["targetState"] = "PAUSED";
      check(f.call(who, "/admin/intents", j).status ==
                ((who == "A" || who == "M") ? 200
                 : who == "G"               ? 401
                                            : 404),
            "admin-" + who);
      j["role"] = "admin";
      check(f.call("U", "/admin/intents", j).status != 200,
            "forged-role-" + who);
    }
    for (const std::string state : {"OPEN", "PAUSED"}) {
      Fixture f;
      auto w = f.create();
      auto rid = f.reg("U", w).body["registrationId"].asString();
      if (state == "PAUSED")
        f.admin("STATE", w, "PAUSED");
      auto wrong = f.reg("V", w, "x", rid),
           missing = f.reg("V", w, "y", "missing");
      check(wrong.status == 404 && wrong.body == missing.body,
            "ownership-" + state);
      check(f.reg("A", w, "z", rid).status == 404,
            "admin-cannot-cancel-" + state);
    }
  } else if (selected == "P05") {
    Fixture f;
    auto w1 = f.create(), w2 = f.create(), draft = f.create(10, "DRAFT");
    static_cast<void>(draft);
    auto rows = f.call("G", "/workshops", {}, "GET").body;
    check(rows.size() == 2 && rows[0]["id"].asString() == std::min(w1, w2),
          "stable-id-tie");
    JsonValue patch;
    patch["schedule"] = valid()["schedule"];
    patch["schedule"]["start"] = "2020-01-01T00:00:00Z";
    patch["schedule"]["end"] = "2020-01-01T01:00:00Z";
    f.admin("EDIT", w2, patch);
    check(f.call("G", "/workshops", {}, "GET").body[0]["id"] == w2,
          "past-still-listed-first");
  } else if (selected == "P06") {
    Fixture f;
    auto w = f.create();
    auto a = f.reg("U", w).body["registrationId"].asString();
    f.reg("U", w, "cancel", a);
    auto b = f.reg("U", w).body["registrationId"].asString();
    auto history = f.call("U", "/me/registrations", {}, "GET").body;
    check(history.size() == 1 && history[0]["registrations"].size() == 2 &&
              a != b,
          "history-keeps-two-identities");
    check(f.call("V", "/me/registrations", {}, "GET").body.empty(),
          "no-other-history");
    check(f.call("A", "/me/registrations", {}, "GET").status == 404,
          "no-admin-history");
  } else if (selected == "P07") {
    for (const std::string before : {"DRAFT", "OPEN", "PAUSED"})
      for (const std::string target : {"DRAFT", "OPEN", "PAUSED", "other"}) {
        Fixture f;
        auto w = f.create(10, before);
        auto n = f.events();
        auto r = f.admin("STATE", w, target);
        const bool allowed = (before == "DRAFT" && target == "OPEN") ||
                             (before == "OPEN" && target == "PAUSED") ||
                             (before == "PAUSED" && target == "OPEN");
        f.code(r,
               before == target ? "UNCHANGED"
               : allowed        ? "UPDATED"
                                : "STATE_REJECTED",
               std::string(before).append("-").append(target));
        check(f.events() == n + (allowed ? 1 : 0),
              std::string("event-").append(before).append(target));
      }
  } else if (selected == "P08") {
    for (const std::string state : {"DRAFT", "OPEN", "PAUSED"}) {
      Fixture f;
      auto w = f.create(10, state);
      auto before = f.call("A", "/admin/workshops/" + w, {}, "GET").body;
      auto after = f.store
                       ->handle("GET", "/admin/workshops/" + w, "FAKE-A", "",
                                "", {}, 2000000000)
                       .body;
      before.removeMember("observedAt");
      after.removeMember("observedAt");
      check(before == after, "no-clock-transition-" + state);
    }
  }
}
void quota() {
  if (selected == "Q01") {
    Fixture f;
    const auto w1 = f.create(), w2 = f.create(), w3 = f.create(),
               w4 = f.create(1);
    const auto first = f.reg("U", w1, "one");
    check(first.body["code"] == "REGISTERED", "zero-active-accepts");
    check(f.reg("U", w2, "two").body["code"] == "REGISTERED",
          "one-active-accepts");
    auto before = f.events();
    const auto limited = f.reg("U", w3, "limited");
    check(limited.body["code"] == "LIMIT_REACHED" &&
              limited.body["effect"] == "REJECTED",
          "two-active-rejects");
    check(f.active() == 2 && f.events() == before,
          "quota-reject-no-domain-event");
    check(f.reg("U", w1, "duplicate").body["code"] == "ALREADY_REGISTERED",
          "duplicate-before-quota");
    check(f.reg("V", w4, "other-actor").body["code"] == "REGISTERED",
          "quota-is-per-actor");
    check(f.reg("U", w4, "quota-full").body["code"] == "LIMIT_REACHED",
          "quota-before-full");
    f.admin("STATE", w3, "PAUSED");
    check(f.reg("U", w3, "paused-quota").body["code"] == "PAUSED",
          "paused-before-quota");
    f.admin("STATE", w3, "OPEN");
    const auto rid = first.body["registrationId"].asString();
    check(f.reg("U", w1, "cancel", rid).body["code"] == "CANCELLED",
          "cancel-releases-quota");
    check(f.reg("U", w3, "limited").body == limited.body,
          "old-rejection-immutable-after-cancel");
    check(f.reg("U", w3, "fresh").body["code"] == "REGISTERED",
          "cancelled-excluded-fresh-intent-accepts");
    before = f.events();
    check(f.reg("U", w1, "cancel-again", rid).body["code"] == "ALREADY_CANCELLED",
          "repeat-cancel-no-extra-quota");
    check(f.reg("U", w1, "still-limited").body["code"] == "LIMIT_REACHED",
          "repeat-cancel-does-not-free-active");
    check(f.active() == 3 && f.events() == before,
          "repeat-cancel-and-limit-no-event");
  } else if (selected == "Q02") {
    Fixture f;
    const auto a = f.create(), b = f.create(), c = f.create(), d = f.create();
    unsigned n = 0;
    for (const auto &w : {a, b, c}) {
      f.sql("INSERT INTO registrations VALUES('legacy" + std::to_string(++n) +
            "','U','" + w + "','ACTIVE')");
    }
    auto before = f.events();
    check(f.reg("U", d, "legacy-limit").body["code"] == "LIMIT_REACHED",
          "legacy-over-limit-blocks-new");
    check(f.active() == 3 && f.events() == before,
          "legacy-rows-retained-no-event");
    check(f.reg("U", a, "legacy-duplicate").body["code"] == "ALREADY_REGISTERED",
          "legacy-duplicate-keeps-original");
    check(f.reg("U", a, "cancel-one", "legacy1").body["code"] == "CANCELLED",
          "legacy-first-cancel-allowed");
    check(f.reg("U", d, "at-two").body["code"] == "LIMIT_REACHED",
          "legacy-at-two-still-blocked");
    check(f.reg("U", b, "cancel-two", "legacy2").body["code"] == "CANCELLED",
          "legacy-second-cancel-allowed");
    check(f.reg("U", d, "below-two").body["code"] == "REGISTERED",
          "legacy-below-two-accepts");
    check(f.count("SELECT count(*) FROM registrations") == 4 && f.active() == 2,
          "legacy-history-not-deleted");
  } else if (selected == "Q03") {
    for (bool cancelFirst : {false, true}) {
      Fixture f;
      const auto a = f.create(), b = f.create(), c = f.create();
      const auto rid = f.reg("U", a).body["registrationId"].asString();
      f.reg("U", b);
      const auto before = f.events();
      workshop::Response add{}, cancel{};
      if (cancelFirst) {
        cancel = f.reg("U", a, "cancel", rid);
        add = f.reg("U", c, "add");
      } else {
        add = f.reg("U", c, "add");
        cancel = f.reg("U", a, "cancel", rid);
      }
      const std::string suffix = cancelFirst ? "cancel-first" : "register-first";
      check(cancel.body["code"] == "CANCELLED", "cancel-order-" + suffix);
      check(add.body["code"] == (cancelFirst ? "REGISTERED" : "LIMIT_REACHED"),
            "registration-order-" + suffix);
      check(f.active() == (cancelFirst ? 2 : 1) &&
                f.events() == before + (cancelFirst ? 2 : 1),
            "counts-events-order-" + suffix);
      check(f.reg("U", c, "add").body == add.body,
            "retry-preserves-order-" + suffix);
    }
  } else if (selected == "Q04") {
    for (unsigned round = 0; round < 10; ++round) {
      Fixture f;
      const auto a = f.create(), b = f.create(), c = f.create();
      f.reg("U", a);
      const auto before = f.events();
      std::barrier gate(3);
      workshop::Response x{}, y{};
      const auto run = [&](const std::string &wid, const std::string &request,
                           workshop::Response &response) {
        workshop::Store other(f.file);
        auto input = f.base();
        input["requestId"] = request;
        input["workshopId"] = wid;
        gate.arrive_and_wait();
        response = other.handle("POST", "/registrations", "FAKE-U", "FAKE-CSRF-U",
                                "https://workshop.test", input, 1800000000);
      };
      std::thread one(run, b, "concurrent-b", std::ref(x));
      std::thread two(run, c, "concurrent-c", std::ref(y));
      gate.arrive_and_wait();
      one.join();
      two.join();
      const auto suffix = std::to_string(round);
      check((x.body["code"] == "REGISTERED" && y.body["code"] == "LIMIT_REACHED") ||
                (y.body["code"] == "REGISTERED" && x.body["code"] == "LIMIT_REACHED"),
            "cross-workshop-one-winner-" + suffix);
      check(f.active() == 2 && f.events() == before + 1,
            "cross-workshop-atomic-count-event-" + suffix);
      check(f.reg("U", b, "concurrent-b").body == x.body &&
                f.reg("U", c, "concurrent-c").body == y.body,
            "cross-workshop-retry-both-results-" + suffix);
    }
  }
}

void registration() {
  if (selected == "R04") {
    for (int n : {1, 10}) {
      Fixture f;
      auto w = f.create(10);
      auto rid = f.reg("U", w).body["registrationId"].asString();
      for (int i = 1; i < n; ++i)
        f.sql("INSERT INTO registrations VALUES('s" + std::to_string(i) +
              "','s" + std::to_string(i) + "','" + w + "','ACTIVE')");
      auto before = f.events();
      f.code(f.reg("U", w, "C", rid), "CANCELLED",
             "cancel-N" + std::to_string(n));
      check(f.active() == n - 1 && f.events() == before + 1,
            "one-slot-released-N" + std::to_string(n));
    }
    return;
  }
  if (selected == "R01" || selected == "R02") {
    for (int capacity : {1, 10}) {
      Fixture f;
      auto w = f.create(capacity);
      for (int i = 0; i < capacity - (selected == "R01" ? 1 : 0); ++i) {
        f.sql("INSERT INTO registrations VALUES('seed" + std::to_string(i) +
              "','seed" + std::to_string(i) + "','" + w + "','ACTIVE')");
      }
      auto n = f.events();
      f.code(f.reg("U", w), selected == "R01" ? "REGISTERED" : "FULL",
             "capacity-" + std::to_string(capacity));
      check(f.active() == capacity &&
                f.events() == n + (selected == "R01" ? 1 : 0),
            "count-event-" + std::to_string(capacity));
    }
  } else if (selected == "R03") {
    for (int capacity : {1, 10}) {
      Fixture f;
      auto w = f.create(capacity);
      f.reg("U", w);
      auto n = f.events();
      f.code(f.reg("U", w), "ALREADY_REGISTERED",
             "duplicate-before-full-" + std::to_string(capacity));
      check(f.active() == 1 && f.events() == n, "no-duplicate-event");
    }
  } else if (selected == "R04" || selected == "R05" || selected == "R06") {
    for (int capacity : {1, 10}) {
      Fixture f;
      auto w = f.create(capacity);
      auto a = f.reg("U", w).body["registrationId"].asString();
      f.code(f.reg("U", w, "cancel-a", a), "CANCELLED", "first-cancel");
      check(f.active() == 0, "released");
      if (selected == "R05") {
        auto b = f.reg("U", w).body["registrationId"].asString();
        check(a != b, "new-id");
      }
      auto n = f.events();
      for (int i = 0; i < 2; ++i)
        f.code(f.reg("U", w, "again" + std::to_string(i), a),
               "ALREADY_CANCELLED", "old-id-" + std::to_string(i));
      check(f.events() == n && f.active() == (selected == "R05" ? 1 : 0),
            "old-id-does-not-affect-B");
    }
  } else if (selected == "R07") {
    for (bool active : {false, true})
      for (bool full : {false, true}) {
        Fixture f;
        auto w = f.create(full ? 1 : 10);
        std::string rid;
        if (active)
          rid = f.reg("U", w).body["registrationId"].asString();
        else if (full)
          f.reg("V", w);
        f.admin("STATE", w, "PAUSED");
        auto n = f.events();
        f.code(f.reg("U", w), "PAUSED",
               "new-paused-" + std::to_string(active) + std::to_string(full));
        if (active)
          f.code(f.reg("U", w, "cancel", rid), "PAUSED", "cancel-paused");
        check(f.events() == n, "paused-no-event");
      }
    Fixture f;
    auto w = f.create();
    auto rid = f.reg("U", w).body["registrationId"].asString();
    f.reg("U", w, "c", rid);
    f.admin("STATE", w, "PAUSED");
    f.code(f.reg("U", w, "again", rid), "PAUSED",
           "paused-before-already-cancelled");
  } else if (selected == "R08") {
    Fixture f;
    auto w = f.create(10, "DRAFT");
    check(f.reg("U", w).status == 404, "draft-not-accessible");
    auto j = f.base();
    j["requestId"] = "x";
    j["workshopId"] = w;
    check(f.call("U", "/registrations//cancel", j).status == 400,
          "missing-cancel-id");
    check(f.active() == 0, "unchanged");
  }
}
void retry() {
  Fixture f;
  auto w = f.create();
  if (selected == "I01" || selected == "I09") {
    if (selected == "I09") {
      std::barrier gate(3);
      workshop::Response a{}, b{};
      JsonValue j = f.base();
      j["requestId"] = "X";
      j["workshopId"] = w;
      auto run = [&](workshop::Response &r) {
