    partial["schedule"]["start"] = "2026-10-01T01:00:00Z";
    f.code(f.admin("EDIT", w, partial), "INVALID_FIELDS",
           "schedule-atomic-group");
    auto intent = f.base();
    intent["intentId"] = "intent";
    intent["action"] = "CREATE";
    intent["fields"] = valid();
    check(f.call("M", "/admin/intents", intent).status == 404,
          "admin-intent-other-owner");
    check(f.call("A", "/admin/intents/missing", {}, "GET").body["state"] ==
              "UNKNOWN",
          "admin-missing-unknown");
  } else if (selected == "ADMISSION") {
    workshop::Admission gate;
    const auto now = workshop::Admission::Clock::now();
    for (int i = 0; i < 200; ++i)
      check(gate.global(now), "global-" + std::to_string(i));
    check(!gate.global(now), "global-over");
    for (int i = 0; i < 40; ++i)
      check(gate.caller("actor:U", now), "actor-" + std::to_string(i));
    check(!gate.caller("actor:U", now) && gate.caller("actor:V", now),
          "actor-isolation");
    check(gate.caller("actor:U", now + std::chrono::seconds(1)), "refill");
    Fixture f;
    workshop::Executor executor(f.file);
    std::promise<void> held, release;
    auto ready = held.get_future();
    auto wait = release.get_future().share();
    check(executor.submit(true,
                          [&](workshop::Store &) {
                            held.set_value();
                            wait.wait();
                          }),
          "worker-held");
    ready.wait();
    for (int i = 0; i < 64; ++i)
      check(executor.submit(true, [](workshop::Store &) {}),
            "queue-" + std::to_string(i));
    check(!executor.submit(true, [](workshop::Store &) {}), "queue-over");
    release.set_value();
    check(executor.drain(std::chrono::seconds(30)) &&
              !executor.submit(false, [](workshop::Store &) {}),
          "drain-stops-admission");
  } else
    throw std::runtime_error("unknown case");
}
} // namespace
int main(int argc, char **argv) {
  if (argc != 2)
    return 2;
  selected = argv[1];
  try {
    if (selected.starts_with("P"))
      permission();
    else if (selected.starts_with("Q"))
      quota();
    else if (selected.starts_with("R"))
      registration();
    else if (selected.starts_with("I"))
      retry();
    else if (selected.size() == 3 && selected.starts_with("C") &&
             selected != "CRASH")
      concurrency();
    else if (selected.starts_with("D"))
      data();
    else
      technical();
    if (assertions == 0)
      throw std::runtime_error("no assertions");
    return 0;
  } catch (const std::exception &e) {
    JsonValue j;
    j["caseId"] = selected;
    j["status"] = "FAIL";
    j["detail"] = e.what();
    std::cout << workshop::dump(j) << '\n' << std::flush;
    return 1;
  }
}
