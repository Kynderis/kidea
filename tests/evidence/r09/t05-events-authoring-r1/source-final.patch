diff --git a/backend/src/update_transport.cpp b/backend/src/update_transport.cpp
new file mode 100644
index 0000000..71fd069
--- /dev/null
+++ b/backend/src/update_transport.cpp
@@ -0,0 +1,270 @@
+#include "workshop/update_transport.hpp"
+#include <drogon/utils/Utilities.h>
+#include <set>
+namespace workshop {
+Updates::Updates(std::shared_ptr<Executor> executor,
+                 std::shared_ptr<Admission> admission, std::string file)
+    : executor_(std::move(executor)), admission_(std::move(admission)),
+      file_(std::move(file)) {}
+std::int64_t Updates::now() {
+  return std::chrono::duration_cast<std::chrono::seconds>(
+             std::chrono::system_clock::now().time_since_epoch())
+      .count();
+}
+void Updates::close(const drogon::WebSocketConnectionPtr &connection) {
+  const auto found = sockets_.find(connection);
+  if (found != sockets_.end()) {
+    quota_.release(found->second.quotaKey);
+    sockets_.erase(found);
+  }
+  connection->forceClose();
+}
+void Updates::handleNewConnection(
+    const drogon::HttpRequestPtr &request,
+    const drogon::WebSocketConnectionPtr &connection) {
+  // Controller callbacks set this once, before the worker receives the socket.
+  // Count pending handshakes as well as authorized connections.
+  const auto counted = std::make_shared<std::atomic<bool>>(false);
+  connection->setContext(counted);
+  if (openings_.fetch_add(1) >= 128) {
+    openings_.fetch_sub(1);
+    connection->forceClose();
+    return;
+  }
+  counted->store(true);
+  connection->disablePing();
+  const auto self = shared_from_this();
+  const auto origin = request->getHeader("origin"),
+             token = request->getCookie("workshop_session"),
+             peer = request->peerAddr().toIp();
+  // Never accept credentials or subscriptions in URLs. A browser sends CSRF in
+  // its first bounded SUBSCRIBE frame; no data is emitted before validation.
+  if (!request->getQuery().empty() ||
+      !executor_->submit(
+          false, [self, connection, origin, token, peer](Store &) {
+            try {
+              if (!self->journal_)
+                self->journal_ = std::make_unique<UpdateJournal>(self->file_);
+              const auto key = "peer:" + peer;
+              if (!connection->connected() ||
+                  origin != self->journal_->metadata("origin") ||
+                  !self->quota_.acquire(key, false)) {
+                connection->forceClose();
+                return;
+              }
+              State state;
+              state.subscription.token = token;
+              state.subscription.origin = origin;
+              state.peer = peer;
+              state.quotaKey = key;
+              self->sockets_.emplace(connection, std::move(state));
+            } catch (...) {
+              connection->forceClose();
+            }
+          }))
+    connection->forceClose();
+}
+bool Updates::emit(Store &store,
+                   const drogon::WebSocketConnectionPtr &connection,
+                   State &state, const Json &message) {
+  if (!connection->connected() ||
+      !updateAuthorized(store, *journal_, state.subscription, now()))
+    return false;
+  // Place an unpredictable credit receipt AFTER all payload bytes. Returning it
+  // proves receipt of this entire frame, not business mutation/delivery
+  // success.
+  const auto receipt = drogon::utils::secureRandomString(32);
+  Json marker(receipt);
+  const auto frame =
+      "{\"message\":" + dump(message) + ",\"receipt\":" + dump(marker) + "}";
+  if (!state.credit.reserve(receipt, frame.size() + 10))
+    return false;
+  connection->send(frame);
+  return true;
+}
+void Updates::subscribe(Store &store,
+                        const drogon::WebSocketConnectionPtr &connection,
+                        State &state, const Json &input) {
+  keys(input, {"type", "audience", "workshopId", "csrf", "epoch"},
+       {"type", "audience", "csrf", "epoch"});
+  if (state.subscribed)
+    throw Invalid("RESUBSCRIBE");
+  auto &s = state.subscription;
+  s.audience = string(input, "audience");
+  s.epoch = string(input, "epoch");
+  s.csrf = string(input, "csrf");
+  if (s.audience == "private") {
+    if (input.isMember("workshopId"))
+      throw Invalid("PRIVATE_SCOPE");
+  } else {
+    s.workshop = string(input, "workshopId");
+    if (s.workshop.empty())
+      throw Invalid("SCOPE");
+  }
+  if (!s.token.empty()) {
+    const auto session =
+        store.handle("GET", "/session", s.token, "", "", Json{}, now());
+    if (session.status != 200)
+      throw Invalid("SESSION");
+    s.actor = session.body["actor"].asString();
+  }
+  if (!updateAuthorized(store, *journal_, s, now()) || !admission_->global() ||
+      !admission_->caller(store.rateKey(s.token, now(), state.peer)))
+    throw Invalid("AUTHORIZATION");
+  if (!s.token.empty()) {
+    const auto key = "actor:" + s.actor;
+    quota_.release(state.quotaKey);
+    state.quotaKey.clear();
+    if (!quota_.acquire(key, true))
+      throw Invalid("ACTOR_QUOTA");
+    state.quotaKey = key;
+  }
+  state.subscribed = true;
+  Json subscribed;
+  subscribed["type"] = "SUBSCRIBED";
+  subscribed["epoch"] = s.epoch;
+  subscribed["audience"] = s.audience;
+  if (!emit(store, connection, state, subscribed))
+    throw Invalid("EMIT");
+  // Subscription exists BEFORE reading, so the next worker commit is either
+  // in this snapshot or in the durable outbox scanned by tick().
+  const auto snapshot = updateSnapshot(store, *journal_, s, now());
+  if (!snapshot)
+    throw Invalid("SNAPSHOT");
+  Json message;
+  message["type"] = "SNAPSHOT";
+  message["epoch"] = s.epoch;
+  message["audience"] = s.audience;
+  message["data"] = *snapshot;
+  if (!emit(store, connection, state, message))
+    throw Invalid("EMIT");
+}
+void Updates::handleNewMessage(const drogon::WebSocketConnectionPtr &connection,
+                               std::string &&message,
+                               const drogon::WebSocketMessageType &type) {
+  const auto self = shared_from_this();
+  if (message.size() > 8192 || type != drogon::WebSocketMessageType::Text) {
+    connection->forceClose();
+    return;
+  }
+  if (!executor_->submit(false, [self, connection,
+                                 message = std::move(message)](Store &store) {
+        auto found = self->sockets_.find(connection);
+        if (found == self->sockets_.end()) {
+          connection->forceClose();
+          return;
+        }
+        auto &state = found->second;
+        try {
+          if (!state.frames.accept())
+            throw Invalid("FRAME_RATE");
+          const auto input = decode(message);
+          const auto kind = string(input, "type");
+          if (kind == "SUBSCRIBE")
+            self->subscribe(store, connection, state, input);
+          else if (kind == "ACK") {
+            keys(input, {"type", "receipt"}, {"type", "receipt"});
+            if (!state.subscribed ||
+                !state.credit.acknowledge(string(input, "receipt")))
+              throw Invalid("ACK");
+          } else
+            throw Invalid("FRAME_TYPE");
+        } catch (...) {
+          self->close(connection);
+        }
+      }))
+    connection->forceClose();
+}
+void Updates::handleConnectionClosed(
+    const drogon::WebSocketConnectionPtr &connection) {
+  const auto counted = connection->getContext<std::atomic<bool>>();
+  if (counted && counted->exchange(false))
+    openings_.fetch_sub(1);
+  const auto self = shared_from_this();
+  // If saturated, tick removes disconnected sockets; no unbounded cleanup job.
+  executor_->submit(false,
+                    [self, connection](Store &) { self->close(connection); });
+}
+void Updates::tick() {
+  if (ticking_.exchange(true))
+    return;
+  const auto self = shared_from_this();
+  if (!executor_->submit(false, [self](Store &store) {
+        try {
+          if (!self->journal_)
+            self->journal_ = std::make_unique<UpdateJournal>(self->file_);
+          const auto events = self->journal_->pending();
+          std::set<std::string> workshops;
+          for (const auto &e : events) {
+            if (e.epoch != self->journal_->metadata("epoch"))
+              throw StorageError("OUTBOX_EPOCH");
+            workshops.insert(e.workshop);
+          }
+          std::vector<drogon::WebSocketConnectionPtr> closing;
+          for (auto &[connection, state] : self->sockets_) {
+            try {
+              if (!connection->connected() ||
+                  (!state.subscribed &&
+                   Clock::now() - state.accepted > std::chrono::seconds(5))) {
+                closing.push_back(connection);
+                continue;
+              }
+              if (!state.subscribed)
+                continue;
+              if (workshops.contains(state.subscription.workshop) ||
+                  (state.subscription.workshop == "*" && !workshops.empty()) ||
+                  (state.subscription.audience == "private" &&
+                   !workshops.empty())) {
+                const auto data = updateSnapshot(store, *self->journal_,
+                                                 state.subscription, now());
+                if (!data) {
+                  closing.push_back(connection);
+                  continue;
+                }
+                Json message;
+                message["type"] = "SNAPSHOT";
+                message["audience"] = state.subscription.audience;
+                message["epoch"] = state.subscription.epoch;
+                message["data"] = *data;
+                if (!self->emit(store, connection, state, message)) {
+                  closing.push_back(connection);
+                  continue;
+                }
+              }
+              if (Clock::now() - state.heartbeat >= std::chrono::seconds(2)) {
+                Json message;
+                message["type"] = "HEARTBEAT";
+                message["epoch"] = state.subscription.epoch;
+                message["audience"] = state.subscription.audience;
+                if (!self->emit(store, connection, state, message))
+                  closing.push_back(connection);
+                else
+                  state.heartbeat = Clock::now();
+              }
+            } catch (...) {
+              throw;
+            }
+          }
+          for (const auto &connection : closing)
+            self->close(connection);
+          // Authoritative snapshot construction + dispatch processing
+          // completed. This does NOT certify each browser's visibility. On
+          // send/crash/mark failure the obligation remains pending; duplicate
+          // snapshots are safe.
+          self->journal_->complete(events);
+        } catch (...) {
+          std::vector<drogon::WebSocketConnectionPtr> closing;
+          for (const auto &[connection, state] : self->sockets_) {
+            static_cast<void>(state);
+            closing.push_back(connection);
+          }
+          for (const auto &connection : closing)
+            self->close(connection);
+          // Persisted outbox remains pending. A later tick/start retries only
+          // projection processing, never a business mutation.
+        }
+        self->ticking_.store(false);
+      }))
+    ticking_.store(false);
+}
+} // namespace workshop
diff --git a/backend/src/updates.cpp b/backend/src/updates.cpp
new file mode 100644
index 0000000..5bfcc2b
--- /dev/null
+++ b/backend/src/updates.cpp
@@ -0,0 +1,210 @@
+#include "workshop/updates.hpp"
+#include <algorithm>
+#include <limits>
+namespace workshop {
+namespace {
+struct Query {
+  sqlite3_stmt *stmt{};
+  std::deque<std::string> strings;
+  Query(sqlite3 *db, const char *sql) {
+    if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) != SQLITE_OK)
+      throw StorageError("UPDATE_PREPARE");
+  }
+  ~Query() { sqlite3_finalize(stmt); }
+  Query(const Query &) = delete;
+  Query &operator=(const Query &) = delete;
+  void text(int i, const std::string &value) {
+    strings.push_back(value);
+    const auto &owned = strings.back();
+    if (value.size() >
+            static_cast<std::size_t>(std::numeric_limits<int>::max()) ||
+        sqlite3_bind_text(stmt, i, owned.data(), static_cast<int>(value.size()),
+                          SQLITE_STATIC) != SQLITE_OK)
+      throw StorageError("UPDATE_BIND");
+  }
+  void number(int i, std::int64_t value) {
+    if (sqlite3_bind_int64(stmt, i, value) != SQLITE_OK)
+      throw StorageError("UPDATE_BIND");
+  }
+  bool row() {
+    const auto code = sqlite3_step(stmt);
+    if (code == SQLITE_ROW)
+      return true;
+    if (code == SQLITE_DONE)
+      return false;
+    throw StorageError("UPDATE_STEP");
+  }
+  std::string value(int i) const {
+    const auto *p = sqlite3_column_text(stmt, i);
+    if (!p)
+      throw StorageError("UPDATE_NULL");
+    return {reinterpret_cast<const char *>(p),
+            static_cast<std::size_t>(sqlite3_column_bytes(stmt, i))};
+  }
+};
+void execute(sqlite3 *db, const char *sql) {
+  if (sqlite3_exec(db, sql, nullptr, nullptr, nullptr) != SQLITE_OK)
+    throw StorageError("UPDATE_EXEC");
+}
+} // namespace
+UpdateJournal::UpdateJournal(const std::string &file) {
+  if (sqlite3_open_v2(file.c_str(), &db_,
+                      SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX,
+                      nullptr) != SQLITE_OK) {
+    sqlite3_close(db_);
+    db_ = nullptr;
+    throw StorageError("UPDATE_OPEN");
+  }
+  try {
+    if (sqlite3_busy_timeout(db_, 100) != SQLITE_OK)
+      throw StorageError("UPDATE_BUSY");
+    execute(db_, "PRAGMA foreign_keys=ON; PRAGMA synchronous=FULL;");
+    Query version(db_, "PRAGMA user_version");
+    if (!version.row() || sqlite3_column_int(version.stmt, 0) != 1)
+      throw StorageError("UPDATE_SCHEMA");
+  } catch (...) {
+    sqlite3_close(db_);
+    db_ = nullptr;
+    throw;
+  }
+}
+UpdateJournal::~UpdateJournal() { sqlite3_close(db_); }
+std::string UpdateJournal::metadata(const char *key) {
+  Query q(db_, "SELECT value FROM metadata WHERE key=?");
+  q.text(1, key);
+  if (!q.row())
+    throw StorageError("UPDATE_METADATA");
+  return q.value(0);
+}
+std::vector<UpdateEvent> UpdateJournal::pending() {
+  Query q(db_, "SELECT id,epoch,workshop,version FROM outbox WHERE completed=0 "
+               "ORDER BY id LIMIT 64");
+  std::vector<UpdateEvent> result;
+  while (q.row())
+    result.push_back(
+        {sqlite3_column_int64(q.stmt, 0), q.value(1), q.value(2), q.value(3)});
+  return result;
+}
+void UpdateJournal::complete(const std::vector<UpdateEvent> &events) {
+  if (events.empty())
+    return;
+  execute(db_, "BEGIN IMMEDIATE");
+  try {
+    for (const auto &event : events) {
+      Query q(db_, "UPDATE outbox SET completed=1 WHERE id=? AND epoch=? AND "
+                   "workshop=? AND version=?");
+      q.number(1, event.id);
+      q.text(2, event.epoch);
+      q.text(3, event.workshop);
+      q.text(4, event.version);
+      if (q.row() || sqlite3_changes(db_) != 1)
+        throw StorageError("UPDATE_IDENTITY");
+    }
+    execute(db_, "COMMIT");
+  } catch (...) {
+    sqlite3_exec(db_, "ROLLBACK", nullptr, nullptr, nullptr);
+    throw;
+  }
+}
+bool updateAuthorized(Store &store, UpdateJournal &journal,
+                      const Subscription &s, std::int64_t now) {
+  if (s.origin != journal.metadata("origin") ||
+      s.epoch != journal.metadata("epoch") ||
+      (s.audience != "public" && s.audience != "admin" &&
+       s.audience != "private"))
+    return false;
+  if (s.token.empty())
+    return s.audience == "public" && s.actor.empty() && s.csrf.empty();
+  const auto session =
+      store.handle("GET", "/session", s.token, "", "", Json{}, now);
+  if (session.status >= 500)
+    throw StorageError("UPDATE_AUTH_UNCONFIRMED");
+  const auto &v = session.body;
+  return session.status == 200 && v["actor"].asString() == s.actor &&
+         v["epoch"].asString() == s.epoch && !s.csrf.empty() &&
+         v["csrf"].asString() == s.csrf &&
+         (s.audience != "admin" || v["admin"].asBool()) &&
+         (s.audience != "private" || v["participant"].asBool());
+}
+std::optional<Json> updateSnapshot(Store &store, UpdateJournal &journal,
+                                   const Subscription &s, std::int64_t now) {
+  if (!updateAuthorized(store, journal, s, now))
+    return std::nullopt;
+  const auto route =
+      s.audience == "private"
+          ? "/me/registrations"
+          : (s.audience == "admin" ? "/admin/workshops" : "/workshops") +
+                (s.workshop == "*" ? "" : "/" + s.workshop);
+  const auto result = store.handle("GET", route, s.token, "", "", Json{}, now);
+  if (result.status >= 500)
+    throw StorageError("UPDATE_SNAPSHOT_UNCONFIRMED");
+  if (result.status != 200)
+    return std::nullopt;
+  if (s.audience == "private") {
+    if (!result.body.isArray())
+      return std::nullopt;
+    for (const auto &group : result.body)
+      if (group["actor"].asString() != s.actor ||
+          group["epoch"].asString() != s.epoch)
+        return std::nullopt;
+  } else if (s.workshop == "*") {
+    if (!result.body.isArray())
+      return std::nullopt;
+    for (const auto &w : result.body)
+      if (w["epoch"].asString() != s.epoch ||
+          (s.audience == "public" && w["state"].asString() == "DRAFT"))
+        return std::nullopt;
+  } else if (result.body["id"].asString() != s.workshop ||
+             result.body["epoch"].asString() != s.epoch) {
+    return std::nullopt;
+  }
+  return result.body;
+}
+bool UpdateCredit::reserve(const std::string &receipt, std::size_t bytes) {
+  if (receipt.empty() || pending_.size() >= 8 || bytes > 1048576 ||
+      bytes_ > 1048576 - bytes ||
+      std::any_of(pending_.begin(), pending_.end(),
+                  [&](const auto &v) { return v.first == receipt; }))
+    return false;
+  pending_.emplace_back(receipt, bytes);
+  bytes_ += bytes;
+  return true;
+}
+bool UpdateCredit::acknowledge(const std::string &receipt) {
+  // Only receipt of the oldest complete frame releases one credit. No guessed
+  // numeric cursor can acknowledge bytes a slow reader has not consumed.
+  if (pending_.empty() || pending_.front().first != receipt)
+    return false;
+  bytes_ -= pending_.front().second;
+  pending_.pop_front();
+  return true;
+}
+bool SocketQuota::acquire(const std::string &key, bool authenticated) {
+  const auto found = owners_.find(key);
+  const auto owned = found == owners_.end() ? 0 : found->second;
+  if (total_ >= 128 || owned >= (authenticated ? 8U : 16U))
+    return false;
+  ++owners_[key];
+  ++total_;
+  return true;
+}
+void SocketQuota::release(const std::string &key) {
+  const auto found = owners_.find(key);
+  if (found == owners_.end())
+    return;
+  --total_;
+  if (--found->second == 0)
+    owners_.erase(found);
+}
+bool FrameRate::accept(Clock::time_point now) {
+  tokens_ = std::min(
+      10.0,
+      tokens_ +
+          std::max(0.0, std::chrono::duration<double>(now - at_).count()) * 5);
+  at_ = now;
+  if (tokens_ < 1)
+    return false;
+  --tokens_;
+  return true;
+}
+} // namespace workshop
