+
+test('private explicit reconciliation resolves equal version while preserving newer CANCELLED',()=>{const client=new ClientState('A','E'),c={...client.context};const group={actor:'A',epoch:'E',workshopId:'W',workshopVersion:'2',registrations:[{id:'R',state:'CANCELLED'}]};client.merge(group,c);client.merge({...group,registrations:[{id:'R',state:'ACTIVE'}]},c);assert.equal(client.uncertain.has('W'),true);assert.equal(reconcileHistory(client,[group],c),true);assert.equal(reconcileHistory(client,[{...group,workshopVersion:'1',registrations:[{id:'R',state:'ACTIVE'}]}],c),true);assert.equal(client.history.get('W').registrations[0].state,'CANCELLED');client.reset('B','E');assert.equal(reconcileHistory(client,[group],c),false);assert.equal(client.history.size,0);});
