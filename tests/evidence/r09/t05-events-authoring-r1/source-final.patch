+
+test('malformed socket collection never partially advances private history',()=>{const client=new ClientState('A','E'),c={...client.context};const group={actor:'A',epoch:'E',workshopId:'W',workshopVersion:'1',registrations:[{id:'R',state:'CANCELLED'}]};assert.equal(mergeHistory(client,[group,{...group,actor:'B'}],c),false);assert.equal(client.history.size,0);assert.equal(mergeHistory(client,[group,group],c),false);assert.equal(mergeHistory(client,[group],c),true);assert.equal(client.history.get('W').registrations[0].state,'CANCELLED');});
+
+test('a contradictory duplicate workshop in one collection is rejected before applying either',()=>{const s=new PublicUpdates('E',[]);assert.equal(s.merge([snap(),snap('1',{title:'Contradiction'})],'SOCKET'),false);assert.equal(s.snapshots.size,0);assert.equal(s.merge([snap(),snap()],'HTTP'),false);assert.equal(s.snapshots.size,0);});
