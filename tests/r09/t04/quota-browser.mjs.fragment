 // T04: a PAUSED workshop's ACTIVE row still consumes actor quota.
 const quotaWorkshops=[];
 for(const n of [2,3]){
  const created=await admin.request.post(base+'/api/v1/admin/intents',{headers:{origin:base,'x-csrf-token':'FAKE-CSRF-A'},data:{epoch:'epoch-t02-fixture',intentId:'quota-create-'+n,action:'CREATE',fields:{title:'Workshop hạn mức '+n,description:'Dữ liệu giả kiểm hạn mức toàn workshop.',capacity:10,schedule:{start:'2026-10-01T09:00:00+07:00',end:'2026-10-01T10:00:00+07:00'}}}});assert.equal(created.status(),200);const body=await created.json();assert.equal(body.code,'CREATED');
  const opened=await admin.request.post(base+'/api/v1/admin/intents',{headers:{origin:base,'x-csrf-token':'FAKE-CSRF-A'},data:{epoch:'epoch-t02-fixture',intentId:'quota-open-'+n,action:'STATE',workshopId:body.workshopId,targetState:'OPEN'}});assert.equal((await opened.json()).code,'UPDATED');quotaWorkshops.push(body.workshopId);
 }
 const quotaPage=await restoredU.newPage();await quotaPage.goto(base+'/workshops/'+quotaWorkshops[0]);await quotaPage.getByRole('button',{name:'Đăng ký',exact:true}).click();await quotaPage.getByText('Lần đó đăng ký thành công.',{exact:false}).waitFor();record('quota-second-ACTIVE-real-browser');
 await quotaPage.goto(base+'/workshops/'+quotaWorkshops[1]);await quotaPage.getByRole('button',{name:'Đăng ký',exact:true}).click();await quotaPage.getByText('Tại thời điểm xử lý, bạn đã đạt hạn mức hai đăng ký đang hiệu lực.',{exact:false}).waitFor();
 const quotaWrites=requests.filter(r=>r.initialContextActor==='U'&&r.method==='POST'&&r.path==='/api/v1/registrations'&&JSON.parse(r.body).workshopId===quotaWorkshops[1]);assert.equal(quotaWrites.length,1);const limitedId=JSON.parse(quotaWrites[0].body).requestId;const limitedResult=await api(restoredU,'/requests/'+limitedId);assert.equal(limitedResult.code,'LIMIT_REACHED');assert.equal((await api(restoredU,'/workshops/'+quotaWorkshops[1])).active,0);record('quota-third-ACTIVE-rejected-without-consuming-seat');await quotaPage.screenshot({path:'/out/quota-rejected.png',fullPage:true});
 await quotaPage.goto(base+'/workshops/'+quotaWorkshops[0]);await quotaPage.getByRole('button',{name:'Hủy đăng ký',exact:true}).click();await quotaPage.getByRole('button',{name:'Xác nhận hủy',exact:true}).click();await quotaPage.getByText('Lần đó hủy đăng ký thành công.',{exact:false}).waitFor();assert.deepEqual(await api(restoredU,'/requests/'+limitedId),limitedResult);
 await quotaPage.goto(base+'/workshops/'+quotaWorkshops[1]);await quotaPage.getByRole('button',{name:'Đăng ký',exact:true}).click();await quotaPage.getByText('Lần đó đăng ký thành công.',{exact:false}).waitFor();const quotaHistory=await api(restoredU,'/me/registrations');assert.equal(quotaHistory.flatMap(g=>g.registrations).filter(r=>r.state==='ACTIVE').length,2);assert.deepEqual(await api(restoredU,'/requests/'+limitedId),limitedResult);record('quota-cancel-releases-slot-new-intent-old-rejection-immutable');
